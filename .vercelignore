# Keep source files for both Vercel projects because this file is shared by the
# web and api deployments. Only exclude local secrets, runtime data, logs, and
# bulky generated artifacts.

# Local secrets must never be uploaded. Vercel uses project env vars instead.
**/.env
**/.env.*
!**/.env.example

# Local runtime data and generated outputs.
apps/api/data/
apps/api/debug_screenshots/
apps/api/dist/
apps/web/dist/
data/
debug_screenshots/
downloads/
graphify-out/

# Local inspection/test artifacts.
.playwright-cli/
transcripts_test/
course_videos/
secondbrain/
awesome-design-md/

# Native build outputs are large and not needed by web/api deployments.
native/ios-wrapper/.derivedData/
