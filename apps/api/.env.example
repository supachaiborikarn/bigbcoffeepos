DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"
JWT_SECRET="replace-with-a-long-random-secret"
PORT=5175

# Optional audit log file. If omitted, defaults to apps/api/data/audit.log when run from apps/api.
# AUDIT_LOG_FILE="./data/audit.log"

# Local SQLite backup settings, used only when DATABASE_URL is absent/placeholder/file:.
DB_BACKUP_ENABLED=1
DB_BACKUP_INTERVAL_MINUTES=60
DB_BACKUP_RETENTION_COUNT=48
DB_BACKUP_ON_STARTUP=1

# Optional integrations.
# POSPOS_EMAIL=""
# POSPOS_PASSWORD=""
# RD_TAX_ENDPOINT=""
# RD_TAX_CLIENT_ID=""
# RD_TAX_CLIENT_SECRET=""
# LINE_OA_CHANNEL_ACCESS_TOKEN=""
# LINEMAN_API_ENDPOINT=""
# LINEMAN_API_KEY=""
