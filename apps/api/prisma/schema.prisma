generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  id         Int      @id @default(autoincrement())
  name       String
  location   String   @default("")
  branchType String   @default("coffee") @map("branch_type")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  orders          Order[]
  shifts          Shift[]
  ingredientStocks IngredientStock[]
  cupStockSettings CupStockSetting[]
  stockMovements  StockMovement[]
  purchases       Purchase[]
  users           User[]
  storeSetting    StoreSetting?
  taxInvoices     TaxInvoice[]
  stockCounts     StockCount[]
  stockTransfersFrom StockTransfer[] @relation("StockTransferFromBranch")
  stockTransfersTo   StockTransfer[] @relation("StockTransferToBranch")
  inventoryLots   InventoryLot[]
  businessDocuments BusinessDocument[]
  marketplaceConnections MarketplaceConnection[]

  @@map("branches")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  pin       String
  role      String   @default("cashier")
  branchId  Int?     @map("branch_id")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  orders Order[]
  shifts Shift[]
  branch Branch? @relation(fields: [branchId], references: [id])
  approvedPurchases Purchase[] @relation("PurchaseApprovedBy")

  @@map("users")
}

model MenuItem {
  id         Int      @id @default(autoincrement())
  sku        String?
  barcode    String?
  name       String
  category   String   @default("")
  basePrice  Float    @default(0) @map("base_price")
  cost       Float?
  imageUrl   String?  @map("image_url")
  unit       String?
  taxRate    Float?   @map("tax_rate")
  source     String?
  sourceId   String?  @map("source_id")
  optionGroup String? @map("option_group")
  optionLabel String? @map("option_label")
  metadata   String   @default("{}")
  branchType String   @default("coffee") @map("branch_type")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  orderItems OrderItem[]
  recipes    Recipe[]
  productUnits ProductUnit[]
  priceRules PriceRule[]
  productVariants ProductVariant[]

  @@index([source, sourceId])
  @@index([optionGroup])
  @@map("menu_items")
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String   @unique
  points    Int      @default(0)
  tier      String   @default("REGULAR")
  memberCode String? @unique @map("member_code")
  birthday  DateTime?
  notes     String   @default("")
  totalSpend Float   @default(0) @map("total_spend")
  creditBalance Float @default(0) @map("credit_balance")
  tags      String   @default("[]")
  lineUserId String? @map("line_user_id")
  metadata  String   @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  orders Order[]
  taxInvoices TaxInvoice[]

  @@map("customers")
}

model Ingredient {
  id          Int      @id @default(autoincrement())
  name        String
  unit        String   @default("ชิ้น")
  costPerUnit Float    @default(0) @map("cost_per_unit")
  createdAt   DateTime @default(now()) @map("created_at")

  stocks         IngredientStock[]
  recipes        Recipe[]
  cupStockSettingItems CupStockSettingItem[]
  stockMovements StockMovement[]
  stockCountItems StockCountItem[]
  stockTransferItems StockTransferItem[]
  inventoryLots InventoryLot[]

  @@map("ingredients")
}

model IngredientStock {
  id           Int @id @default(autoincrement())
  branchId     Int @map("branch_id")
  ingredientId Int @map("ingredient_id")
  stockQty     Float @default(0) @map("stock_qty")
  reorderLevel Float @default(0) @map("reorder_level")

  branch     Branch     @relation(fields: [branchId], references: [id])
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([branchId, ingredientId])
  @@map("ingredient_stocks")
}

model Recipe {
  id           Int @id @default(autoincrement())
  menuItemId   Int @map("menu_item_id")
  ingredientId Int @map("ingredient_id")
  qty          Float @default(1)

  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id])
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([menuItemId, ingredientId])
  @@map("recipes")
}

model CupStockSetting {
  id          Int      @id @default(autoincrement())
  branchId    Int      @map("branch_id")
  cupOption   String   @map("cup_option")
  deductStock Boolean  @default(false) @map("deduct_stock")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  branch Branch @relation(fields: [branchId], references: [id])
  items  CupStockSettingItem[]

  @@unique([branchId, cupOption])
  @@index([branchId])
  @@map("cup_stock_settings")
}

model CupStockSettingItem {
  id           Int   @id @default(autoincrement())
  settingId    Int   @map("setting_id")
  ingredientId Int   @map("ingredient_id")
  qty          Float @default(1)

  setting    CupStockSetting @relation(fields: [settingId], references: [id], onDelete: Cascade)
  ingredient Ingredient      @relation(fields: [ingredientId], references: [id])

  @@unique([settingId, ingredientId])
  @@index([ingredientId])
  @@map("cup_stock_setting_items")
}

model StockMovement {
  id           Int      @id @default(autoincrement())
  branchId     Int      @map("branch_id")
  ingredientId Int      @map("ingredient_id")
  qty          Float
  reason       String   @default("ADJUSTMENT")
  createdAt    DateTime @default(now()) @map("created_at")

  branch     Branch     @relation(fields: [branchId], references: [id])
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@map("stock_movements")
}

model Order {
  id                Int      @id @default(autoincrement())
  branchId          Int      @map("branch_id")
  customerId        Int?     @map("customer_id")
  userId            Int?     @map("user_id")
  shiftId           Int?     @map("shift_id")
  status            String   @default("PAID")
  subtotal          Float    @default(0)
  discountType      String?  @map("discount_type")
  discountValue     Float    @default(0) @map("discount_value")
  discountAmount    Float    @default(0) @map("discount_amount")
  loyaltyPointsUsed Int      @default(0) @map("loyalty_points_used")
  loyaltyPointsEarned Int    @default(0) @map("loyalty_points_earned")
  tax               Float    @default(0)
  total             Float    @default(0)
  paymentMethod     String   @default("CASH") @map("payment_method")
  idempotencyKey    String?  @unique @map("idempotency_key")
  createdAt         DateTime @default(now()) @map("created_at")

  branch   Branch    @relation(fields: [branchId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])
  shift    Shift?    @relation(fields: [shiftId], references: [id])
  items    OrderItem[]
  payments Payment[]
  events   OrderEvent[]
  taxInvoice TaxInvoice?

  @@index([branchId])
  @@index([shiftId])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id         Int    @id @default(autoincrement())
  orderId    Int    @map("order_id")
  menuItemId Int    @map("menu_item_id")
  name       String
  qty        Float  @default(1)
  basePrice  Float  @default(0) @map("base_price")
  modifiers  String @default("[]")
  lineTotal  Float  @default(0) @map("line_total")
  note       String?

  order    Order    @relation(fields: [orderId], references: [id])
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id                Int      @id @default(autoincrement())
  orderId           Int      @map("order_id")
  method            String
  status            String   @default("CONFIRMED")
  amountDue         Float    @default(0) @map("amount_due")
  amountReceived    Float?   @map("amount_received")
  changeAmount      Float?   @map("change_amount")
  referenceNo       String?  @map("reference_no")
  confirmedByUserId Int?     @map("confirmed_by_user_id")
  confirmedAt       DateTime @default(now()) @map("confirmed_at")
  createdAt         DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([method])
  @@index([status])
  @@map("payments")
}

model OrderEvent {
  id        Int      @id @default(autoincrement())
  orderId   Int      @map("order_id")
  eventType String   @map("event_type")
  actorId   Int?     @map("actor_id")
  reason    String?
  payload   String   @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([eventType])
  @@index([createdAt])
  @@map("order_events")
}

model Shift {
  id          Int       @id @default(autoincrement())
  branchId    Int       @map("branch_id")
  userId      Int?      @map("user_id")
  openingCash Float     @default(0) @map("opening_cash")
  closingCash Float?    @map("closing_cash")
  expectedCash Float?   @map("expected_cash")
  difference  Float?
  totalSales  Float     @default(0) @map("total_sales")
  totalOrders Int       @default(0) @map("total_orders")
  cashSales   Float     @default(0) @map("cash_sales")
  qrSales     Float     @default(0) @map("qr_sales")
  cardSales   Float     @default(0) @map("card_sales")
  status      String    @default("OPEN")
  openedAt    DateTime  @default(now()) @map("opened_at")
  closedAt    DateTime? @map("closed_at")

  branch Branch  @relation(fields: [branchId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])
  orders Order[]

  @@index([branchId])
  @@index([status])
  @@map("shifts")
}

model IntegrationOutbox {
  id         Int      @id @default(autoincrement())
  provider   String
  eventType  String   @map("event_type")
  entityType String   @map("entity_type")
  entityId   Int?     @map("entity_id")
  status     String   @default("PENDING")
  attempts   Int      @default(0)
  payload    String   @default("{}")
  lastError  String?  @map("last_error")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([provider])
  @@index([status])
  @@index([createdAt])
  @@map("integration_outbox")
}

model Purchase {
  id        Int      @id @default(autoincrement())
  branchId  Int      @map("branch_id")
  supplier  String   @default("")
  note      String   @default("")
  total     Float    @default(0)
  status    String   @default("RECEIVED")
  approvedByUserId Int? @map("approved_by_user_id")
  approvedAt DateTime? @map("approved_at")
  createdAt DateTime @default(now()) @map("created_at")

  branch Branch         @relation(fields: [branchId], references: [id])
  approvedBy User?      @relation("PurchaseApprovedBy", fields: [approvedByUserId], references: [id])
  items  PurchaseItem[]

  @@map("purchases")
}

model PurchaseItem {
  id           Int    @id @default(autoincrement())
  purchaseId   Int    @map("purchase_id")
  ingredientId Int?   @map("ingredient_id")
  description  String @default("")
  qty          Float  @default(0)
  unitCost     Float  @default(0) @map("unit_cost")
  lineTotal    Float  @default(0) @map("line_total")

  purchase Purchase @relation(fields: [purchaseId], references: [id])

  @@map("purchase_items")
}

model StoreSetting {
  id             Int      @id @default(autoincrement())
  branchId       Int      @unique @map("branch_id")
  shopName       String   @default("") @map("shop_name")
  taxId          String   @default("") @map("tax_id")
  branchLabel    String   @default("") @map("branch_label")
  addressLine    String   @default("") @map("address_line")
  phone          String   @default("")
  receiptHeader  String   @default("") @map("receipt_header")
  receiptFooter  String   @default("ขอบคุณที่ใช้บริการ") @map("receipt_footer")
  vatMode        String   @default("INCLUSIVE") @map("vat_mode")
  vatRate        Float    @default(7) @map("vat_rate")
  paymentMethods String   @default("[\"CASH\",\"QR\",\"CARD\"]") @map("payment_methods")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  branch Branch @relation(fields: [branchId], references: [id])

  @@map("store_settings")
}

model TaxInvoice {
  id          Int      @id @default(autoincrement())
  branchId    Int      @map("branch_id")
  orderId     Int      @unique @map("order_id")
  customerId  Int?     @map("customer_id")
  invoiceNo   String   @unique @map("invoice_no")
  buyerName   String   @map("buyer_name")
  buyerTaxId  String   @default("") @map("buyer_tax_id")
  buyerAddress String  @default("") @map("buyer_address")
  buyerBranch String   @default("") @map("buyer_branch")
  subtotal    Float    @default(0)
  discountAmount Float @default(0) @map("discount_amount")
  tax         Float    @default(0)
  total       Float    @default(0)
  status      String   @default("ISSUED")
  eTaxStatus  String   @default("PENDING") @map("e_tax_status")
  createdAt   DateTime @default(now()) @map("created_at")

  branch   Branch    @relation(fields: [branchId], references: [id])
  order    Order     @relation(fields: [orderId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([branchId])
  @@index([createdAt])
  @@map("tax_invoices")
}

model StockCount {
  id        Int      @id @default(autoincrement())
  branchId  Int      @map("branch_id")
  status    String   @default("DRAFT")
  note      String   @default("")
  createdAt DateTime @default(now()) @map("created_at")
  postedAt  DateTime? @map("posted_at")

  branch Branch @relation(fields: [branchId], references: [id])
  items  StockCountItem[]

  @@index([branchId])
  @@index([status])
  @@map("stock_counts")
}

model StockCountItem {
  id            Int   @id @default(autoincrement())
  stockCountId  Int   @map("stock_count_id")
  ingredientId  Int   @map("ingredient_id")
  expectedQty   Float @default(0) @map("expected_qty")
  countedQty    Float @default(0) @map("counted_qty")
  differenceQty Float @default(0) @map("difference_qty")

  stockCount StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([stockCountId, ingredientId])
  @@map("stock_count_items")
}

model StockTransfer {
  id           Int      @id @default(autoincrement())
  fromBranchId Int     @map("from_branch_id")
  toBranchId   Int     @map("to_branch_id")
  status       String  @default("DRAFT")
  note         String  @default("")
  createdAt    DateTime @default(now()) @map("created_at")
  approvedAt   DateTime? @map("approved_at")
  receivedAt   DateTime? @map("received_at")

  fromBranch Branch @relation("StockTransferFromBranch", fields: [fromBranchId], references: [id])
  toBranch   Branch @relation("StockTransferToBranch", fields: [toBranchId], references: [id])
  items      StockTransferItem[]

  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([status])
  @@map("stock_transfers")
}

model StockTransferItem {
  id              Int   @id @default(autoincrement())
  stockTransferId Int   @map("stock_transfer_id")
  ingredientId    Int   @map("ingredient_id")
  qty             Float @default(0)

  stockTransfer StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  ingredient    Ingredient    @relation(fields: [ingredientId], references: [id])

  @@map("stock_transfer_items")
}

model ProductUnit {
  id        Int    @id @default(autoincrement())
  menuItemId Int   @map("menu_item_id")
  unitName  String @map("unit_name")
  factor    Float  @default(1)
  price     Float?
  barcode   String?
  active    Boolean @default(true)

  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([menuItemId])
  @@map("product_units")
}

model PriceRule {
  id        Int      @id @default(autoincrement())
  menuItemId Int?    @map("menu_item_id")
  customerTier String @default("") @map("customer_tier")
  minQty    Float    @default(1) @map("min_qty")
  price     Float
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  menuItem MenuItem? @relation(fields: [menuItemId], references: [id])

  @@index([menuItemId])
  @@map("price_rules")
}

model InventoryLot {
  id           Int      @id @default(autoincrement())
  branchId     Int      @map("branch_id")
  ingredientId Int      @map("ingredient_id")
  lotNo        String   @default("") @map("lot_no")
  qty          Float    @default(0)
  expiryDate   DateTime? @map("expiry_date")
  createdAt    DateTime @default(now()) @map("created_at")

  branch     Branch     @relation(fields: [branchId], references: [id])
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@index([branchId])
  @@index([expiryDate])
  @@map("inventory_lots")
}

model ProductVariant {
  id        Int     @id @default(autoincrement())
  menuItemId Int    @map("menu_item_id")
  sku       String?
  barcode   String?
  optionName String @default("") @map("option_name")
  optionValue String @default("") @map("option_value")
  priceDelta Float @default(0) @map("price_delta")
  active    Boolean @default(true)

  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([menuItemId])
  @@map("product_variants")
}

model Promotion {
  id        Int      @id @default(autoincrement())
  name      String
  type      String
  value     Float    @default(0)
  category  String   @default("")
  startAt   DateTime? @map("start_at")
  endAt     DateTime? @map("end_at")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([active])
  @@map("promotions")
}

model Coupon {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  type      String
  value     Float    @default(0)
  maxUses   Int?     @map("max_uses")
  usedCount Int      @default(0) @map("used_count")
  expiresAt DateTime? @map("expires_at")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([active])
  @@map("coupons")
}

model BusinessDocument {
  id        Int      @id @default(autoincrement())
  branchId  Int      @map("branch_id")
  type      String
  documentNo String  @unique @map("document_no")
  customerName String @default("") @map("customer_name")
  total     Float    @default(0)
  status    String   @default("DRAFT")
  payload   String   @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  branch Branch @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@index([type])
  @@map("business_documents")
}

model DailyEmailSetting {
  id        Int      @id @default(autoincrement())
  branchId  Int?     @map("branch_id")
  recipients String  @default("")
  sendTime  String   @default("21:00") @map("send_time")
  enabled   Boolean  @default(false)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("daily_email_settings")
}

model MarketplaceConnection {
  id        Int      @id @default(autoincrement())
  branchId  Int      @map("branch_id")
  provider  String
  shopName  String   @default("") @map("shop_name")
  status    String   @default("READY")
  config    String   @default("{}")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([branchId, provider])
  @@map("marketplace_connections")
}

model Migration {
  id        Int      @id @default(autoincrement())
  filename  String   @unique
  appliedAt DateTime @default(now()) @map("applied_at")

  @@map("_migrations")
}
