{
  "version": 2,
  "buildCommand": "cd ../.. && npm install && cd apps/api && npx prisma generate && npm run build",
  "installCommand": "npm install",
  "framework": null,
  "builds": [
    {
      "src": "src/index.ts",
      "use": "@vercel/node"
    }
  ],
  "functions": {
    "src/index.ts": {
      "maxDuration": 300,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/src/index.ts"
    }
  ]
}
